# ============================================================================
# FXseek 媒体库 —— 仓库只放「源码 + 构建脚本 + 前端资源 + 示例素材」。
# 下面是运行时产物 / 本机数据 / 第三方二进制，一律不入库。
# 注意：gitignore 不支持「行尾注释」，所以说明都单独占一行。
# ============================================================================

# ---- 运行时（体积巨大、且在每台机器上重建，见 docs/运行时与二进制.md）----
# 自包含 CPython 3.11 + mlx / mlx-vlm / Pillow / openpyxl / pdfplumber …（约 550 MB）
/venv/
# 内置多模态模型（约 1.8 GB，首次启动由 model_dl.py 自动下载）
/model/
# ffmpeg / ffprobe / fpcalc 及其依赖 dylib（第三方二进制）
/bin/

# ---- 构建产物 ----
/dist/
/dmgstage/
*.dmg
# i18n 资源导出产物（tools/export_i18n.js 生成，可随时重建）
/build/

# ---- 本机数据 / 用户隐私 ----
/data/
/settings.local.json
*.local.json
/backup/
*.log

# ---- Python / macOS / 编辑器垃圾 ----
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.idea/
.vscode/
*.swp
